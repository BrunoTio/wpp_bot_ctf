# Puerto local del servidor
PORT=3000

# Token que inventas vos para verificar el webhook en Meta
VERIFY_TOKEN=pon_un_token_largo_aca

# Token permanente o temporal de WhatsApp Cloud API
WHATSAPP_TOKEN=EAAG...

# ID del numero de telefono de WhatsApp Cloud API, no el numero visible
PHONE_NUMBER_ID=123456789012345

# Version de Graph API
GRAPH_API_VERSION=v23.0

# Texto fijo que respondera el bot
RESPONSE_TEXT=Felicitaciones. Esta es la pista del juego de captura la bandera.

# Elegi UNA de estas dos opciones:
# 1) URL publica directa de la imagen
RESPONSE_IMAGE_URL=https://tudominio.com/imagen.jpg

# 2) Media ID ya subido a WhatsApp Cloud API
# RESPONSE_IMAGE_ID=123456789012345

# Opcional: App Secret de Meta para validar firmas x-hub-signature-256
# APP_SECRET=...
